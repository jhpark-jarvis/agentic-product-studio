{
  "name": "agentic-product-studio",
  "version": "1.0.0",
  "description": "Human-and-AI product collaboration hub for documents, planning, schedules, members, and assets.",
  "main": "index.js",
  "scripts": {
    "cf:deploy": "wrangler deploy",
    "cf:deploy:dry": "wrangler deploy --dry-run",
    "cf:deploy:python:dry": "wrangler deploy --dry-run --config worker-python/wrangler.toml",
    "cf:tail:python": "wrangler tail --config worker-python/wrangler.toml",
    "cf:tail": "wrangler tail",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhpark-jarvis/agentic-product-studio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jhpark-jarvis/agentic-product-studio/issues"
  },
  "homepage": "https://github.com/jhpark-jarvis/agentic-product-studio#readme",
  "devDependencies": {
    "wrangler": "^4.107.0"
  }
}
